<!DOCTYPE html>
<!--[if lt IE 7]>      <html class="no-js lt-ie9 lt-ie8 lt-ie7"> <![endif]-->
<!--[if IE 7]>         <html class="no-js lt-ie9 lt-ie8"> <![endif]-->
<!--[if IE 8]>         <html class="no-js lt-ie9"> <![endif]-->
<!--[if gt IE 8]><!--> <html class="no-js"> <!--<![endif]-->
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="robots" content="noindex, nofollow" />
    <title>Something Went Wrong – The Tyee Builders</title>
    <link href="<%= $config->{'static_asset_path'} %>/ui/css/styles.css" rel="stylesheet" media="screen">
    <script src="<%= $config->{'static_asset_path'} %>/ui/js/modernizr.js"></script>
    <script type="text/javascript" src="//use.typekit.net/sjz2xsw.js"></script>
    <script type="text/javascript">try{Typekit.load();}catch(e){}</script>
    <link rel="shortcut icon" href="https://thetyee.ca/design-article.thetyee.ca/ui/img/favicon.ico">
</head>
<body id="not-found">
    %= include 'header'
    <div class="container" id="content" style="padding-top:60px;">
        <h1>Something went wrong on our end.</h1>
        <p class="alert alert-danger"><i class="glyphicon glyphicon-exclamation-sign"></i> We hit a technical problem processing your request. If you were trying to make a donation, please <a href="mailto:builders@thetyee.ca">email us at builders@thetyee.ca</a> and we'll make sure it's sorted out. <a href="/">Return to the Tyee Builders page</a></p>
    </div>
    %= include 'footer_scripts'
</body>
</html>
